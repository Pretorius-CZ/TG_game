{
  "name": "tg-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run site:check && npm run i18n:check",
    "build": "vite build",
    "i18n:check": "node scripts/check-localization.mjs",
    "i18n:report": "node scripts/check-localization.mjs --report",
    "site:generate": "node scripts/generate-site-pages.mjs",
    "site:check": "node scripts/generate-site-pages.mjs --check",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "prebuild:itch": "npm run i18n:check",
    "build:itch": "vite build --mode itch && node scripts/package-itch.mjs",
    "prebuild:crazygames": "npm run i18n:check",
    "build:crazygames": "vite build --mode crazygames && node scripts/package-crazygames.mjs",
    "prebuild:android": "npm run i18n:check",
    "build:android": "vite build --mode android",
    "android:doctor": "node scripts/android-preflight.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:doctor && npm run android:sync && node scripts/android-build.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.64.1",
    "axe-core": "^4.14.0",
    "rolldown": "1.2.8",
    "vite": "^8.3.0"
  }
}
