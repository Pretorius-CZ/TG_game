{
  "name": "tg-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "build:itch": "vite build --mode itch && node scripts/package-itch.mjs",
    "build:crazygames": "vite build --mode crazygames && node scripts/package-crazygames.mjs",
    "build:android": "vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:doctor && npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:doctor": "node scripts/android-preflight.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "vite": "^8.3.0"
  }
}
